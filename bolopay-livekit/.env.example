# Gnani LiveKit plugin expects a single API key. If your account gives separate STT/TTS keys,
# use GNANI_API_KEY if available; otherwise the agent falls back to the STT key for both plugins.
GNANI_API_KEY=replace_me
GNANI_STT_API_KEY=replace_me
GNANI_TTS_API_KEY=replace_me
GROQ_API_KEY=replace_me
GROQ_MODEL=llama-3.3-70b-versatile
GNANI_TTS_MODEL=timbre-v2.5
GNANI_VOICE=Nalini

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me

# Public token service URL used by Streamlit frontend
BOLOPAY_TOKEN_URL=https://your-token-service.onrender.com/token
ALLOWED_ORIGINS=*
